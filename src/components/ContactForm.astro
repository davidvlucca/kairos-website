---
const waNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER ?? '351XXXXXXXXX';
const w3fKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
---

<section id="contacto" style="padding: var(--space-xl) 0;">
  <div class="section-container">

    <!-- Header centered -->
    <div style="text-align:center; margin-bottom: 3.5rem;">
      <span class="pill-label">CONTACTO · CONTACT</span>
      <h2 style="font-size: clamp(2rem, 5vw, 3rem); font-weight: 700; margin-top: 1.25rem;">
        Vamos falar.
      </h2>
      <p style="color: var(--text-secondary); margin-top: 0.75rem; font-size: 1.05rem;">
        Preenche o formulário ou fala connosco diretamente no WhatsApp.
      </p>
    </div>

    <!-- Form wrapper: max-width 560px, margin auto -->
    <div style="max-width: 560px; margin: 0 auto;">

      <!-- Contact form div (NOT a <form> element) -->
      <div id="contact-form" data-wa={waNumber} data-key={w3fKey} style="display: flex; flex-direction: column; gap: 1.25rem;">

        <!-- Nome -->
        <div>
          <label for="nome" style="display:block; font-size:0.85rem; font-weight:500; color:var(--text-secondary); margin-bottom:0.4rem;">Nome</label>
          <input type="text" id="nome" name="nome" required placeholder="O teu nome" class="form-input" />
        </div>

        <!-- Negócio -->
        <div>
          <label for="negocio" style="display:block; font-size:0.85rem; font-weight:500; color:var(--text-secondary); margin-bottom:0.4rem;">Negócio</label>
          <input type="text" id="negocio" name="negocio" required placeholder="Nome da tua empresa ou marca" class="form-input" />
        </div>

        <!-- Plano de interesse -->
        <div>
          <label for="plano" style="display:block; font-size:0.85rem; font-weight:500; color:var(--text-secondary); margin-bottom:0.4rem;">Plano de interesse</label>
          <select id="plano" name="plano" required class="form-input" style="cursor:pointer; appearance:none; -webkit-appearance:none;">
            <option value="" disabled selected style="background: #111; color: rgba(255,255,255,0.5);">Seleciona um plano</option>
            <option value="Plano Essencial — €197" style="background: #111; color: #fff;">Plano Essencial — €197</option>
            <option value="Plano Completo — €447" style="background: #111; color: #fff;">Plano Completo — €447</option>
            <option value="Ainda não sei" style="background: #111; color: #fff;">Ainda não sei</option>
          </select>
        </div>

        <!-- Mensagem -->
        <div>
          <label for="mensagem" style="display:block; font-size:0.85rem; font-weight:500; color:var(--text-secondary); margin-bottom:0.4rem;">Mensagem</label>
          <textarea id="mensagem" name="mensagem" rows="4" placeholder="Conta-nos um pouco sobre o teu negócio e o que precisas." class="form-input" style="resize:vertical; min-height:120px;"></textarea>
        </div>

        <!-- Submit button -->
        <button id="submit-btn" type="button" class="btn-primary" style="width:100%; justify-content:center; font-size:1rem; padding: 1rem 2rem; cursor:pointer; border:none;">
          Enviar Mensagem
        </button>

        <!-- Status messages (hidden by default) -->
        <div id="form-success" style="display:none; padding:1.25rem; background:rgba(74,222,128,0.08); border:1px solid rgba(74,222,128,0.2); border-radius:12px; color:#4ade80; font-size:0.95rem; text-align:center;">
          Mensagem enviada. Entraremos em contacto em breve.
        </div>
        <div id="form-error" style="display:none; padding:1.25rem; background:rgba(248,113,113,0.08); border:1px solid rgba(248,113,113,0.2); border-radius:12px; color:#f87171; font-size:0.95rem; text-align:center;">
          Algo correu mal. Tenta novamente ou <a href="#" id="error-wa-link" style="color:#f87171; font-weight:600; text-decoration:underline;">fala connosco no WhatsApp</a>.
        </div>

      </div>

      <!-- WhatsApp alternative -->
      <div style="text-align:center; margin-top:2rem;">
        <span style="color:var(--text-muted); font-size:0.9rem;">ou fala connosco diretamente → </span>
        <a id="wa-direct-link" href="#" class="btn-ghost" style="padding:0.5rem 1.25rem; font-size:0.9rem; margin-left:0.5rem;">
          WhatsApp
        </a>
      </div>

    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const formEl = document.getElementById('contact-form');
    const waNumber = (formEl as HTMLElement)?.dataset.wa ?? '';
    const w3fKey = (formEl as HTMLElement)?.dataset.key ?? '';
    const waUrl = `https://wa.me/${waNumber}`;

    // Set WA links
    const waDirectLink = document.getElementById('wa-direct-link');
    const errorWaLink = document.getElementById('error-wa-link');
    if (waDirectLink) waDirectLink.setAttribute('href', waUrl);
    if (errorWaLink) errorWaLink.setAttribute('href', waUrl);

    const submitBtn = document.getElementById('submit-btn');
    const successEl = document.getElementById('form-success');
    const errorEl = document.getElementById('form-error');

    submitBtn?.addEventListener('click', async () => {
      const nome = (document.getElementById('nome') as HTMLInputElement)?.value.trim();
      const negocio = (document.getElementById('negocio') as HTMLInputElement)?.value.trim();
      const plano = (document.getElementById('plano') as HTMLSelectElement)?.value;
      const mensagem = (document.getElementById('mensagem') as HTMLTextAreaElement)?.value.trim();

      if (!nome || !negocio || !plano || !mensagem) {
        alert('Por favor preenche todos os campos.');
        return;
      }

      // Loading state
      (submitBtn as HTMLButtonElement).textContent = 'A enviar...';
      submitBtn.setAttribute('disabled', 'true');
      (submitBtn as HTMLButtonElement).style.opacity = '0.6';
      if (successEl) (successEl as HTMLElement).style.display = 'none';
      if (errorEl) (errorEl as HTMLElement).style.display = 'none';

      try {
        const payload = {
          access_key: w3fKey,
          subject: `[Kairos] Novo contacto — ${plano}`,
          name: nome,
          negocio,
          plano,
          message: mensagem,
        };
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (data.success) {
          if (successEl) (successEl as HTMLElement).style.display = 'block';
          // Reset fields
          (document.getElementById('nome') as HTMLInputElement).value = '';
          (document.getElementById('negocio') as HTMLInputElement).value = '';
          (document.getElementById('plano') as HTMLSelectElement).value = '';
          (document.getElementById('mensagem') as HTMLTextAreaElement).value = '';
        } else {
          if (errorEl) (errorEl as HTMLElement).style.display = 'block';
        }
      } catch {
        if (errorEl) (errorEl as HTMLElement).style.display = 'block';
      } finally {
        (submitBtn as HTMLButtonElement).textContent = 'Enviar Mensagem';
        submitBtn.removeAttribute('disabled');
        (submitBtn as HTMLButtonElement).style.opacity = '1';
      }
    });
  });
</script>
