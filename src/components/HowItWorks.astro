<section id="como-funciona" style="padding: var(--space-xl) 0;">
  <div class="section-container">

    <!-- Header -->
    <div style="text-align: center; margin-bottom: 4rem;">
      <span class="pill-label">O PROCESSO · THE PROCESS</span>
      <h2 style="font-size: clamp(2rem, 5vw, 3rem); font-weight: 700; margin-top: 1.25rem;">
        Simples, rápido, sem surpresas.
      </h2>
      <p style="color: var(--text-secondary); margin-top: 0.75rem; font-size: 1.05rem;">
        Do primeiro contacto ao site no ar em três passos.
      </p>
    </div>

    <!-- Cards grid -->
    <div class="process-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;">

      <!-- Card 1: Briefing -->
      <div class="glass" style="padding: 2rem; transition: border-color 0.2s ease; position: relative;">
        <div style="font-size: 2.5rem; font-weight: 700; color: var(--text-muted); margin-bottom: 1rem; font-variant-numeric: tabular-nums;">01</div>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" style="margin-bottom: 1rem; display: block;">
          <path d="M9 12h6M9 8h6M9 16h4M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/>
        </svg>
        <h3 style="font-size: 1.2rem; font-weight: 600; margin-bottom: 0.6rem;">Briefing</h3>
        <p style="color: var(--text-secondary); line-height: 1.7; font-size: 0.95rem;">
          Conta-nos o teu negócio, o que precisas e envia os materiais. Nós orientamos o processo.
        </p>
      </div>

      <!-- Card 2: Desenvolvimento -->
      <div class="glass" style="padding: 2rem; transition: border-color 0.2s ease; position: relative;">
        <div style="font-size: 2.5rem; font-weight: 700; color: var(--text-muted); margin-bottom: 1rem; font-variant-numeric: tabular-nums;">02</div>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" style="margin-bottom: 1rem; display: block;">
          <polyline points="16 18 22 12 16 6"/>
          <polyline points="8 6 2 12 8 18"/>
        </svg>
        <h3 style="font-size: 1.2rem; font-weight: 600; margin-bottom: 0.6rem;">Desenvolvimento</h3>
        <p style="color: var(--text-secondary); line-height: 1.7; font-size: 0.95rem;">
          Construímos a tua página ou website dentro do prazo acordado. Transparente e sem surpresas.
        </p>
      </div>

      <!-- Card 3: Entrega -->
      <div class="glass" style="padding: 2rem; transition: border-color 0.2s ease; position: relative;">
        <div style="font-size: 2.5rem; font-weight: 700; color: var(--text-muted); margin-bottom: 1rem; font-variant-numeric: tabular-nums;">03</div>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" style="margin-bottom: 1rem; display: block;">
          <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
          <path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
        </svg>
        <h3 style="font-size: 1.2rem; font-weight: 600; margin-bottom: 0.6rem;">Entrega</h3>
        <p style="color: var(--text-secondary); line-height: 1.7; font-size: 0.95rem;">
          Revês, ajustamos se necessário, e o teu site fica no ar. Feito.
        </p>
      </div>

    </div>
  </div>
</section>

<style>
  @media (max-width: 768px) {
    .process-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>
