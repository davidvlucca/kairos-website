---
const waNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER;
---

<section id="planos" style="padding: var(--space-xl) 0;">
  <div class="section-container">

    <div style="text-align:center; margin-bottom: 3.5rem;">
      <span class="pill-label">PLANOS · PLANS</span>
      <h2 style="font-size: clamp(2rem, 5vw, 3rem); font-weight: 700; margin-top: 1.25rem;">
        Escolhe o teu plano.
      </h2>
      <p style="color: var(--text-secondary); margin-top: 0.75rem; font-size: 1.05rem;">
        Sem taxas escondidas. Domínio e alojamento sempre a cargo do cliente.
      </p>
    </div>

    <div class="pricing-grid">

      <!-- Card 1: Essencial (HERO) -->
      <div class="glass pricing-card-hero" style="
        padding: 2.5rem;
        position: relative;
        border-color: var(--border-strong);
        box-shadow: 0 0 60px rgba(255,255,255,0.04);
      ">
        <span style="
          display: inline-block;
          padding: 0.2rem 0.7rem;
          background: #ffffff;
          color: #000000;
          font-size: 0.7rem;
          font-weight: 700;
          letter-spacing: 0.1em;
          text-transform: uppercase;
          border-radius: 999px;
          margin-bottom: 1.25rem;
        ">Mais Popular</span>

        <h3 style="font-size: 1.4rem; font-weight: 700; margin-bottom: 0.25rem;">Essencial</h3>

        <div style="font-size: clamp(2.5rem, 5vw, 3.5rem); font-weight: 700; margin: 0.75rem 0; line-height: 1;">€197</div>

        <p style="color: var(--text-secondary); margin-bottom: 1.75rem; font-size: 0.95rem;">
          A tua presença online em menos de 72 horas.
        </p>

        <div style="height: 1px; background: var(--border); margin-bottom: 1.5rem;"></div>

        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.7rem; margin-bottom: 2rem;">
          <li style="display:flex; gap:0.6rem; align-items:flex-start; font-size:0.95rem;">
            <span style="color:#4ade80; flex-shrink:0; margin-top:0.05rem;">✓</span>
            Landing page de 1 página
          </li>
          <li style="display:flex; gap:0.6rem; align-items:flex-start; font-size:0.95rem;">
            <span style="color:#4ade80; flex-shrink:0; margin-top:0.05rem;">✓</span>
            Design moderno e responsivo
          </li>
          <li style="display:flex; gap:0.6rem; align-items:flex-start; font-size:0.95rem;">
            <span style="color:#4ade80; flex-shrink:0; margin-top:0.05rem;">✓</span>
            Formulário de contacto integrado
          </li>
          <li style="display:flex; gap:0.6rem; align-items:flex-start; font-size:0.95rem;">
            <span style="color:#4ade80; flex-shrink:0; margin-top:0.05rem;">✓</span>
            Entrega em menos de 72 horas
          </li>
          <li style="display:flex; gap:0.6rem; align-items:flex-start; font-size:0.95rem;">
            <span style="color:#4ade80; flex-shrink:0; margin-top:0.05rem;">✓</span>
            1 revisão gratuita incluída
          </li>
          <li style="display:flex; gap:0.6rem; align-items:flex-start; font-size:0.95rem; color: var(--text-muted);">
            <span style="flex-shrink:0; margin-top:0.05rem;">—</span>
            Revisões adicionais: €50/alteração ou €20/hora
          </li>
        </ul>

        <p style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 1.75rem; line-height: 1.5;">
          Domínio e alojamento não incluídos — a cargo do cliente.
        </p>

        <a href={`https://wa.me/${waNumber}`} class="btn-primary" style="width:100%; justify-content:center; display:flex;">
          Começar Agora
        </a>
      </div>

      <!-- Card 2: Completo -->
      <div class="glass" style="padding: 2.5rem; position: relative;">

        <h3 style="font-size: 1.4rem; font-weight: 700; margin-bottom: 0.25rem;">Completo</h3>

        <div style="font-size: clamp(2.5rem, 5vw, 3.5rem); font-weight: 700; margin: 0.75rem 0; line-height: 1;">€447</div>

        <p style="color: var(--text-secondary); margin-bottom: 1.75rem; font-size: 0.95rem;">
          Um sistema web completo para o teu negócio crescer.
        </p>

        <div style="height: 1px; background: var(--border); margin-bottom: 1.5rem;"></div>

        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.7rem; margin-bottom: 2rem;">
          <li style="display:flex; gap:0.6rem; align-items:flex-start; font-size:0.95rem;">
            <span style="color:#4ade80; flex-shrink:0; margin-top:0.05rem;">✓</span>
            Website de 3 a 5 páginas
          </li>
          <li style="display:flex; gap:0.6rem; align-items:flex-start; font-size:0.95rem;">
            <span style="color:#4ade80; flex-shrink:0; margin-top:0.05rem;">✓</span>
            Design moderno e responsivo
          </li>
          <li style="display:flex; gap:0.6rem; align-items:flex-start; font-size:0.95rem;">
            <span style="color:#4ade80; flex-shrink:0; margin-top:0.05rem;">✓</span>
            Formulário de contacto integrado
          </li>
          <li style="display:flex; gap:0.6rem; align-items:flex-start; font-size:0.95rem;">
            <span style="color:#4ade80; flex-shrink:0; margin-top:0.05rem;">✓</span>
            Configuração de automações (n8n)
          </li>
          <li style="display:flex; gap:0.6rem; align-items:flex-start; font-size:0.95rem;">
            <span style="color:#4ade80; flex-shrink:0; margin-top:0.05rem;">✓</span>
            3 revisões gratuitas incluídas
          </li>
          <li style="display:flex; gap:0.6rem; align-items:flex-start; font-size:0.95rem; color: var(--text-muted);">
            <span style="flex-shrink:0; margin-top:0.05rem;">—</span>
            Revisões adicionais: €50/alteração ou €20/hora
          </li>
        </ul>

        <p style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 1.75rem; line-height: 1.5;">
          Domínio e alojamento não incluídos — a cargo do cliente.
        </p>

        <a href="#contacto" class="btn-ghost" style="width:100%; justify-content:center; display:flex;">
          Saber Mais
        </a>
      </div>

    </div>

  </div>
</section>

<style>
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    align-items: start;
  }
  @media (max-width: 640px) {
    .pricing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
